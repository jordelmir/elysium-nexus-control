# Elysium Nexus — Supabase environment template
# Copy to `.env` and fill real values. `.env` is gitignored and never committed.
# Never put service-role / secret keys in committed files or workflows.

# Project ref + region (used to build URLs)
SUPABASE_PROJECT_REF=your-project-ref

# API endpoints
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# JWKS endpoint for JWT validation (public, non-secret)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Publishable (client) key — safe to expose in the APK build config
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# ── SERVICE-ROLE / SECRET — NEVER SHIP IN APK / COMMITTED FILES ────────
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=sb_secret_xxxx

# Postgres connection (direct, dev only)
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
