<?xml version="1.0" encoding="utf-8"?>
<!--
  Elysium Nexus Universal Controller — manifest (Phase 0.7)

  Per MASTER_ORDER.md and ADR-0001, every permission / service /
  activity is added with a written reason. 0.7 adds ONE
  activity: the launcher `MainActivity`, which hosts the touch
  surface and owns the engine. No new permissions yet — the
  touch surface does not need any.

  Permissions we DO NOT need in 0.7 (deferred to 1.x+):
    - BLUETOOTH / BLUETOOTH_ADMIN / BLUETOOTH_CONNECT (Phase 2)
    - INTERNET (only when a transport actually opens a socket)
    - FOREGROUND_SERVICE (when the host service is added in 1.x)
    - WAKE_LOCK (when we add the "keep screen on" toggle in 1.x)
    - VIBRATE (when we wire haptics in 1.x)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Phase ULT.3 — IR control permissions.
      `TRANSMIT_IR` is the §15 permission to send
      infrared signals via the device's IR blaster.
      The permission is `normal` (granted at install
      time, no runtime prompt) on devices that
      support IR; on devices that do not, the
      `ConsumerIrManager` system service returns
      `null` and the `AndroidIrTransmitter` becomes
      a no-op.
    -->
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <!--
      `consumer_ir` is the *feature* (hardware) flag.
      We do NOT mark it as `required="true"` because
      most modern phones do not have an IR blaster.
      The `PackageManager` will return `false` for
      `hasSystemFeature(FEATURE_CONSUMER_IR)` on
      those phones, and the UI will show the "no
      IR" state.
    -->
    <uses-feature
        android:name="android.hardware.consumer_ir"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ElysiumNexus"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name="com.elysium.nexus.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:theme="@style/Theme.ElysiumNexus"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          FileProvider for the §15 profile share intent
          (Phase 1.17). The provider exposes
          `cache/shares/` (see `res/xml/file_paths.xml`)
          to other apps as `content://` URIs. The
          authority is `com.elysium.nexus.controller.fileprovider`,
          built from the applicationId. The grant is
          `FLAG_GRANT_READ_URI_PERMISSION`; the receiving
          app can read the file but not write to it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
