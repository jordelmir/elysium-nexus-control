<?xml version="1.0" encoding="utf-8"?>
<!--
  Elysium Nexus — Android 12+ backup rules.

  Per MASTER_ORDER.md §28.5, the app must not collect credentials, typed
  text, screenshots, clipboard, game history, or opened apps. We
  therefore disable cloud backup, device-to-device transfer, and
  auto-restore: there is nothing user-private we want silently copied
  to Google's servers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
